{
  "name": "telecom-meca",
  "version": "1.0.0",
  "description": "Asistente de IA especializado en Telecomunicaciones y Mecatrónica con Qwen y Ollama",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "telecom-meca": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "server": "tsx src/server.ts",
    "server:build": "npm run build && node dist/server.js",
    "test": "vitest run",
    "test:telecom": "vitest run --dir tests/telecom",
    "test:meca": "vitest run --dir tests/meca",
    "test:live": "vitest run --mode live",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "models:pull": "tsx scripts/pull-models.ts",
    "models:list": "tsx scripts/list-models.ts"
  },
  "keywords": [
    "telecomunicaciones",
    "mecatronica",
    "ia",
    "qwen",
    "ollama",
    "local-ai",
    "robotics",
    "control-systems",
    "rf",
    "signal-processing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "ws": "^8.20.0"
  }
}
